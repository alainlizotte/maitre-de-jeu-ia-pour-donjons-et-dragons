{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiche personnage D&D 3.5",
  "description": "Schema JSON d'une fiche personnage persistante, conforme au Manuel du Joueur D&D 3.5. Utilise par le tool Outil_FichesPerso.",
  "type": "object",
  "required": ["nom", "race", "classe", "niveau", "carac", "pv", "pv_max", "ca", "sauvegardes", "bab"],
  "properties": {
    "nom": {"type": "string", "description": "Nom complet du personnage."},
    "joueur": {"type": "string", "description": "Nom du joueur humain qui incarne ce personnage."},
    "race": {"type": "string", "description": "Race D&D 3.5 (avec sous-race eventuelle)."},
    "classe": {"type": "string", "description": "Classe (et classe de prestige eventuelle)."},
    "niveau": {"type": "integer", "minimum": 1, "description": "Niveau total du personnage."},
    "carac": {
      "type": "object",
      "description": "Caracteristiques D&D 3.5 (valeur brute, 3-18 typique).",
      "properties": {
        "FOR": {"type": "integer"}, "DEX": {"type": "integer"}, "CON": {"type": "integer"},
        "INT": {"type": "integer"}, "SAG": {"type": "integer"}, "CHA": {"type": "integer"}
      },
      "required": ["FOR", "DEX", "CON", "INT", "SAG", "CHA"]
    },
    "pv": {"type": "integer", "minimum": 0, "description": "Points de vie actuels."},
    "pv_max": {"type": "integer", "minimum": 1, "description": "Points de vie maximaux."},
    "ca": {"type": "integer", "description": "Classe d'Armure (CA)."},
    "sauvegardes": {
      "type": "object",
      "properties": {
        "Vigueur": {"type": "integer"},
        "Reflexes": {"type": "integer"},
        "Volonte": {"type": "integer"}
      },
      "required": ["Vigueur", "Reflexes", "Volonte"]
    },
    "bab": {"type": "integer", "description": "Bonus de Base a l'Attaque."},
    "competences": {
      "type": "object",
      "description": "Map nom de competence -> rangs attribues.",
      "additionalProperties": {"type": "number"}
    },
    "dons": {"type": "array", "items": {"type": "string"}, "description": "Liste des dons acquis."},
    "sorts": {
      "type": "object",
      "description": "Sorts connus/prepares selon classe : { 'niveau1': [...] }.",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "equipement": {
      "type": "array",
      "description": "Objets transportes.",
      "items": {
        "type": "object",
        "properties": {"nom": {"type": "string"}, "qte": {"type": "integer"}}
      }
    },
    "or": {"type": "integer", "description": "Or en pieces de cuivre (pc).", "default": 0},
    "alignement": {"type": "string", "description": "Alignement D&D, ex. 'Loyal Bon'."},
    "histoire": {"type": "string", "description": "Background roleplay libre."},
    "conditions": {"type": "array", "items": {"type": "string"}, "description": "Conditions D&D 3.5 actives."}
  }
}
